{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译当前文件 (MSVC x64)",
            "type": "shell",
            "command": "${workspaceFolder}\\_工具\\build-any.cmd",
            "args": [
                "${file}",
                "${workspaceFolder}\\bin"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Ctrl+Shift+B：编译当前打开的 .cpp，产物在 bin\\ 下"
        }
    ]
}
