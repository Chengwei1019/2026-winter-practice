{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (MSVC x64)",
            "type": "shell",
            "command": "${workspaceFolder}\\build.cmd",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Ctrl+Shift+B：用 cl.exe (MSVC 14.51 x64) 编译当前打开的 .cpp，输出到 bin\\"
        },
        {
            "label": "build & run (MSVC x64)",
            "type": "shell",
            "command": "${workspaceFolder}\\run.cmd",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "编译并运行 bin\\<文件名>.exe（不需要调试时用这个）"
        }
    ]
}
